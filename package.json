{
  "name": "snake-arena",
  "version": "1.0.0",
  "private": true,
  "description": "蛇域争霸：5 人局域网 / 外网贪吃蛇竞技场（浏览器 / Windows / Android）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/game.test.js tests/server.test.js",
    "ui-check": "node tests/ui-check.mjs",
    "file-check": "node tests/file-client-check.mjs",
    "solo-check": "node tests/solo-check.mjs",
    "touch-check": "node tests/mobile-touch-check.mjs",
    "tunnel-check": "node tests/tunnel-check.mjs",
    "wan-check": "node tests/wan-check.mjs",
    "build:windows": "powershell -ExecutionPolicy Bypass -File desktop/build-windows.ps1",
    "build:apk": "powershell -ExecutionPolicy Bypass -File mobile/build-apk.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
